datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  LIBRARY_ADMIN
}

enum PeriodStatus {
  ACTIVE
  ARCHIVED
}

enum FeatureType {
  LECTURES
  GOLD_PAPERS
  SUMMARIES
  COURSES
  QUESTION_BANK
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum NotificationCategory {
  NEW_CONTENT
  ANNOUNCEMENT
  SUBSCRIPTION
  COMPLAINT
  SYSTEM
}

enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  phone        String?  @unique
  email        String?  @unique
  fullName     String
  passwordHash String
  role         UserRole @default(LIBRARY_ADMIN)
  libraryId    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  library Library? @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@index([email])
  @@index([libraryId])
  @@map("users")
}

model Library {
  id             String   @id @default(uuid())
  name           String
  code           String   @unique
  logoUrl        String?
  phone          String?
  address        String?
  primaryColor   String   @default("#1a73e8")
  secondaryColor String   @default("#34a853")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  admins               User[]
  timePeriods          TimePeriod[]
  branches             Branch[]
  departments          Department[]
  academicYears        AcademicYear[]
  students             Student[]
  subjects             Subject[]
  subscriptions        Subscription[]
  lectures             Lecture[]
  goldMaterials        GoldMaterial[]
  summaries            SummaryMaterial[]
  courses              Course[]
  questions            QuestionBankItem[]
  storedFiles          StoredFile[]
  notifications        Notification[]
  subscriptionRequests SubscriptionRequest[]
  complaints           Complaint[]
  subscriptionArchives SubscriptionArchive[]

  @@map("libraries")
}

model TimePeriod {
  id        String       @id @default(uuid())
  libraryId String
  name      String
  startDate DateTime
  endDate   DateTime?
  status    PeriodStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  subscriptions        Subscription[]
  lectures             Lecture[]
  goldMaterials        GoldMaterial[]
  summaries            SummaryMaterial[]
  courses              Course[]
  questions            QuestionBankItem[]
  storedFiles          StoredFile[]
  subscriptionRequests SubscriptionRequest[]

  @@index([libraryId, status])
  @@map("time_periods")
}

model Branch {
  id             String   @id @default(uuid())
  libraryId      String
  name           String
  code           String?
  hasDepartments Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  library       Library        @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  departments   Department[]
  academicYears AcademicYear[]
  students      Student[]
  subjects      Subject[]

  @@index([libraryId])
  @@map("branches")
}

model Department {
  id        String   @id @default(uuid())
  libraryId String
  branchId  String
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  library       Library        @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  academicYears AcademicYear[]
  students      Student[]
  subjects      Subject[]

  @@index([libraryId, branchId])
  @@map("departments")
}

model AcademicYear {
  id           String   @id @default(uuid())
  libraryId    String
  branchId     String
  departmentId String?
  name         String // e.g. "السنة الأولى", "السنة الخامسة", "سنة التخرج"
  yearOrder    Int      @default(1) // للترتيب والتسلسل
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  library    Library     @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  subjects   Subject[]
  students   Student[]

  @@index([libraryId, branchId])
  @@index([libraryId, branchId, departmentId])
  @@map("academic_years")
}

model Student {
  id                  String    @id @default(uuid())
  studentCode         String?   @unique
  libraryId           String
  branchId            String?
  departmentId        String?
  academicYearId      String?
  fullName            String
  dateOfBirth         DateTime
  phone               String    @unique
  passwordHash        String?
  isActive            Boolean   @default(true)
  boundDeviceId       String?
  activationCode      String?
  activationExpiresAt DateTime?
  freeTrialActive     Boolean   @default(false)
  freeTrialStartedAt  DateTime?
  freeTrialExpiresAt  DateTime?
  tokenVersion        Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  library              Library                 @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  branch               Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department           Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  academicYear         AcademicYear?           @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  subscriptions        Subscription[]
  notificationReceipts NotificationRecipient[]
  pushTokens           StudentPushToken[]
  subscriptionRequests SubscriptionRequest[]
  complaints           Complaint[]

  @@index([libraryId, branchId])
  @@index([libraryId, departmentId, academicYearId])
  @@map("students")
}

model Subject {
  id             String   @id @default(uuid())
  libraryId      String
  departmentId   String? // القسم الأكاديمي التابعة له المادة
  branchId       String? // الفرع/التخصص (اختياري — للمواد التخصصية)
  academicYearId String? // السنة الدراسية ككيان مستقل
  yearLevel      Int?     @default(1) // اختياري للتوافقية
  name           String
  code           String?
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  library      Library       @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  subscriptions        Subscription[]
  lectures             Lecture[]
  goldMaterials        GoldMaterial[]
  summaries            SummaryMaterial[]
  courses              Course[]
  questions            QuestionBankItem[]
  storedFiles          StoredFile[]
  subscriptionRequests SubscriptionRequest[]

  @@index([libraryId, departmentId, academicYearId]) // الـ Index الرئيسي للفلترة الأكاديمية
  @@index([libraryId, branchId])
  @@map("subjects")
}

model Subscription {
  id           String             @id @default(uuid())
  libraryId    String
  timePeriodId String
  studentId    String
  subjectId    String
  featureType  FeatureType
  materialId   String?
  status       SubscriptionStatus @default(ACTIVE)
  isFreeTrial  Boolean            @default(false)
  subscribedAt DateTime           @default(now())
  expiresAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  library    Library    @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  timePeriod TimePeriod @relation(fields: [timePeriodId], references: [id], onDelete: Restrict)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, featureType, materialId, timePeriodId])
  @@index([libraryId, timePeriodId, status])
  @@index([studentId, subjectId, featureType])
  @@map("subscriptions")
}

model Lecture {
  id           String   @id @default(uuid())
  libraryId    String
  timePeriodId String
  subjectId    String
  title        String
  description  String?
  fileId       String?
  orderIndex   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  library    Library     @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  timePeriod TimePeriod  @relation(fields: [timePeriodId], references: [id], onDelete: Restrict)
  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  file       StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([libraryId, timePeriodId, subjectId])
  @@map("lectures")
}

model GoldMaterial {
  id           String   @id @default(uuid())
  libraryId    String
  timePeriodId String
  subjectId    String
  title        String
  description  String?
  fileUrl      String?
  fileId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  library    Library     @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  timePeriod TimePeriod  @relation(fields: [timePeriodId], references: [id], onDelete: Restrict)
  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  file       StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([libraryId, timePeriodId, subjectId])
  @@map("gold_materials")
}

model SummaryMaterial {
  id           String   @id @default(uuid())
  libraryId    String
  timePeriodId String
  subjectId    String
  title        String
  description  String?
  fileId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  library    Library     @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  timePeriod TimePeriod  @relation(fields: [timePeriodId], references: [id], onDelete: Restrict)
  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  file       StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([libraryId, timePeriodId, subjectId])
  @@map("summary_materials")
}

model Course {
  id           String   @id @default(uuid())
  libraryId    String
  timePeriodId String
  subjectId    String
  title        String
  description  String?
  thumbnailUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  library    Library        @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  timePeriod TimePeriod     @relation(fields: [timePeriodId], references: [id], onDelete: Restrict)
  subject    Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons    CourseLesson[]

  @@index([libraryId, timePeriodId, subjectId])
  @@map("courses")
}

model CourseLesson {
  id         String   @id @default(uuid())
  courseId   String
  title      String
  videoUrl   String?
  duration   String?
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("course_lessons")
}

model QuestionBankItem {
  id            String        @id @default(uuid())
  libraryId     String
  timePeriodId  String
  subjectId     String
  title         String?
  questionText  String?
  questionType  QuestionType? @default(MULTIPLE_CHOICE)
  options       Json?
  correctAnswer String?
  explanation   String?
  difficulty    String?       @default("MEDIUM")
  fileId        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  library    Library     @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  timePeriod TimePeriod  @relation(fields: [timePeriodId], references: [id], onDelete: Restrict)
  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  file       StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([libraryId, timePeriodId, subjectId])
  @@map("question_bank_items")
}

model StoredFile {
  id           String      @id @default(uuid())
  libraryId    String
  timePeriodId String?
  subjectId    String
  featureType  FeatureType
  originalName String
  mimeType     String      @default("application/pdf")
  size         Int
  storageKey   String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  library    Library     @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  timePeriod TimePeriod? @relation(fields: [timePeriodId], references: [id], onDelete: SetNull)
  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  lectures      Lecture[]
  summaries     SummaryMaterial[]
  questions     QuestionBankItem[]
  goldMaterials GoldMaterial[]

  @@index([libraryId, subjectId, featureType])
  @@map("stored_files")
}

/// إشعار واحد (من النظام أو من إدارة المكتبة) يصل لعدة طلاب عبر NotificationRecipient
model Notification {
  id              String               @id @default(uuid())
  libraryId       String
  category        NotificationCategory @default(SYSTEM)
  title           String
  message         String
  /// بيانات الانتقال داخل التطبيق: featureType, subjectId, academicYearId, itemId
  data            Json?
  /// وصف الجمهور المستهدف (للعرض في لوحة التحكم)
  audience        Json?
  createdById     String?
  recipientsCount Int                  @default(0)
  createdAt       DateTime             @default(now())

  library    Library                 @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  recipients NotificationRecipient[]

  @@index([libraryId, createdAt])
  @@map("notifications")
}

/// صندوق وارد الطالب: سطر لكل طالب مستلم مع حالة القراءة
model NotificationRecipient {
  id             String    @id @default(uuid())
  notificationId String
  studentId      String
  libraryId      String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([notificationId, studentId])
  @@index([studentId, createdAt])
  @@index([studentId, readAt])
  @@map("notification_recipients")
}

/// رموز FCM لأجهزة الطالب (أندرويد / iOS / ويب)
model StudentPushToken {
  id        String   @id @default(uuid())
  studentId String
  libraryId String
  token     String   @unique
  platform  String
  deviceId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_push_tokens")
}

model SubscriptionRequest {
  id           String        @id @default(uuid())
  libraryId    String
  timePeriodId String
  studentId    String
  subjectId    String
  featureType  FeatureType
  materialId   String?
  status       RequestStatus @default(PENDING)
  isFreeTrial  Boolean       @default(false)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  library    Library    @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  timePeriod TimePeriod @relation(fields: [timePeriodId], references: [id], onDelete: Restrict)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([libraryId, timePeriodId, status])
  @@index([studentId, featureType, status])
  @@index([studentId, subjectId, featureType, materialId])
  @@map("subscription_requests")
}

model Complaint {
  id          String          @id @default(uuid())
  libraryId   String
  studentId   String
  title       String
  description String
  status      ComplaintStatus @default(PENDING)
  reply       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([libraryId, status])
  @@index([studentId])
  @@map("complaints")
}

model AppRelease {
  id            String   @id @default(uuid())
  version       String
  versionCode   Int
  releaseNotes  String?
  fileName      String
  storageKey    String
  fileSize      BigInt
  mimeType      String   @default("application/vnd.android.package-archive")
  isActive      Boolean  @default(true)
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
  @@index([versionCode])
  @@map("app_releases")
}

/// أرشيف الاشتراكات: لقطة ثابتة (Snapshot) لاشتراكات الدورات المغلقة.
/// تُنقل الاشتراكات إلى هنا عند فتح دورة جديدة ثم تُحذف من جدول الاشتراكات الحي.
/// الأسماء مخزنة كنص لأن المحتوى والملفات تُحذف عند الانتقال للدورة الجديدة.
model SubscriptionArchive {
  id                     String             @id @default(uuid())
  libraryId              String
  timePeriodId           String
  timePeriodName         String
  originalSubscriptionId String
  studentId              String?
  studentName            String
  studentPhone           String?
  subjectId              String?
  subjectName            String
  featureType            FeatureType
  materialId             String?
  materialTitle          String?
  status                 SubscriptionStatus
  isFreeTrial            Boolean            @default(false)
  subscribedAt           DateTime
  expiresAt              DateTime?
  archivedAt             DateTime           @default(now())

  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@index([libraryId, timePeriodId])
  @@index([libraryId, studentId])
  @@index([libraryId, archivedAt])
  @@map("subscription_archives")
}
